<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidApp.MainPage">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Entry x:Name="FirstInput" Placeholder="Введите первое число" Keyboard="Numeric" />

        <Entry x:Name="SecondInput" Placeholder="Введите второе число" Keyboard="Numeric" />

        <Button Text="Сложить числа" Clicked="OnCalculate" />

        <Label x:Name="ResultLabel"
               Text="Результат:"
               FontSize="20"
               HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>